{
  "expo": {
    "name": "La Trinxera",
    "slug": "wodbox",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06090f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wodbox.app"
    },
    "android": {
      "package": "com.wodbox.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f95c00"
      },
      "navigationBar": {
        "backgroundColor": "#0A0A0A",
        "barStyle": "dark-content"
      }
    },
    "scheme": "wodbox",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La Trinxera necesita acceso a tu galería para cambiar tu foto de perfil.",
          "cameraPermission": "La Trinxera necesita acceso a la cámara para hacerte una foto de perfil."
        }
      ]
    ]
  }
}
