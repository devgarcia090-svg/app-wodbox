{
  "expo": {
    "name": "WodBox",
    "slug": "wodbox",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wodbox.app"
    },
    "android": {
      "package": "com.wodbox.app",
      "navigationBar": {
        "backgroundColor": "#0A0A0A",
        "barStyle": "dark-content"
      }
    },
    "scheme": "wodbox",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "WodBox necesita acceso a tu galería para cambiar tu foto de perfil.",
          "cameraPermission": "WodBox necesita acceso a la cámara para hacerte una foto de perfil."
        }
      ]
    ]
  }
}
